# Docker Compose configuration for the current six-stage product pipeline.
# Copy to .env and provide local values. Never commit real secrets.
# Required for real AI execution. These values are consumed only by ai-server.
# AI_PROVIDER supports openai or openai-compatible. AI_BASE_URL is optional for openai.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=<현재 사용 중인 모델>
AI_MODEL_CONCEPT_VALIDATION=<별도로 사용할 모델명>
AI_BASE_URL=
AI_INTERNAL_SERVICE_TOKEN=
# AI trace callback target. compose.yaml uses the fixed backend service URL.
BACKEND_INTERNAL_BASE_URL=http://backend:8080
# Keep false: production behavior never uses a fixture or success fallback.
AI_FIXTURE_MODE=false
# Local-only replay for the shared structured-prompt path (finance, market interview, legal,
# journey). Leave EMPTY unless you are developing: an empty value disables it entirely.
# Set a directory to record successful provider responses and replay them for free afterwards.
# This is NOT a fixture mode -- a miss in "auto" still calls the provider for real.
#   auto   (default) replay on hit, call and record on miss
#   replay strict: a miss fails instead of spending money
AI_REPLAY_DIR=
AI_REPLAY_MODE=auto
AI_PROVIDER_TIMEOUT_SECONDS=60
# Concurrent provider calls; this does not change the fixed 5-slot/15-candidate product limits. Allowed: 1-3.
AI_CONCEPT_GENERATION_CONCURRENCY=1
AI_CONCEPT_TEST_FAILURE_INJECTION=false
AI_CONCEPT_TEST_FAILURE_PLAN=
AI_SERVER_READ_TIMEOUT=75s
AI_SERVER_CONNECT_TIMEOUT=3s
AI_APP_ENVIRONMENT=LOCAL

# Official legal source pipeline (consumed only by ai-server).
# Set MOLEG_API_KEY before validating real legal-source retrieval.
MOLEG_API_KEY=
MOLEG_API_BASE_URL=https://www.law.go.kr/DRF
LEGAL_REGISTRY_VERSION=legal-registry-v1
LEGAL_PROVIDER_TIMEOUT_SECONDS=30
LEGAL_SOURCE_CACHE_SECONDS=3600
#APP_TASK_RUN_LEGAL_PRECHECK_POLL_INTERVAL_MS=1000

# Application services. JWT_SECRET and POSTGRES_PASSWORD are required by compose.
JWT_SECRET=
APP_ENVIRONMENT=LOCAL
POSTGRES_DB=aivle
POSTGRES_USER=aivle
POSTGRES_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000

# Optional first local administrator (leave disabled after provisioning)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Object storage for uploaded files
MINIO_ROOT_USER=aivle-local
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_BUCKET=aivle-ai-artifacts
AI_ARTIFACT_HTTP_TIMEOUT_SECONDS=10
AI_ARTIFACT_MAX_BYTES=1048576

# 시장조사 엔진 (ai/app/research/research2) — compose 가 ai-server 로 넘긴다.
# ⚠ OPENAI_API_KEY 는 AI_API_KEY 와 **별개 지갑**이다. 판 ⑫ 에서 두 계정에 과금되는 사고가 있어
#   갈랐다. 한 지갑으로 쓰려면 같은 값을 여기에 적어서 **명시적으로** 합친다.
# ⚠ OPENAI_BASE_URL 은 /v1/responses 를 지원해야 한다 (chat-only 게이트웨이면 하네스·발췌·요약 전멸).
#   비워 두면 AI_BASE_URL 을 쓴다.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# 수집 어댑터 키. 없으면 그 채널이 not_configured 로 원장에 남는다 (가짜 값을 만들지 않는다).
KOSIS_API_KEY=
DART_API_KEY=
TAVILY_API_KEY=
# BM 분석 모델. 비우면 AI_MODEL 을 쓴다.
BM_MODEL=

# BM 판정의 «생각의 양» — 추론 모델(gpt-5.x 계열)에서만 뜻이 있다.
#   none · low · medium · high · xhigh
#
# ⚠ **온도와 둘 중 하나다.** 값을 주면 온도(0.1)를 안 보낸다 — 둘을 같이 보내면 400 이다.
#   `none` 만 예외로 온도를 같이 보낸다(추론이 꺼지므로 옛 동작 그대로다).
# ⚠ **비워 두면 지금까지와 똑같이 돈다.** `gpt-4o-mini` 는 이 인자를 안 받으므로
#   모델을 안 바꾸면서 이것만 켜면 호출이 죽는다.
#
# 2026-08-15 실측(`p46-bm-luna`): `BM_MODEL=gpt-5.6-luna` + `low` 로 돌리니 4o-mini 가
# **지워 버리던 사용자의 채널 문장 3줄을 살렸다**(라벨을 `concept_snapshot` 으로 바로 붙였다).
BM_REASONING_EFFORT=

# AI Provider credentials are consumed only by the ai-server container.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_INTERNAL_SERVICE_TOKEN=
AI_FIXTURE_MODE=false
AI_PROVIDER_TIMEOUT_SECONDS=60
AI_SERVER_READ_TIMEOUT=75s
AI_SERVER_CONNECT_TIMEOUT=3s
AI_APP_ENVIRONMENT=LOCAL

# Application services
JWT_SECRET=
APP_ENVIRONMENT=LOCAL
POSTGRES_DB=aivle
POSTGRES_USER=aivle
POSTGRES_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000

# Optional first local administrator (leave disabled after provisioning)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Object storage for uploaded files
MINIO_ROOT_USER=aivle-local
MINIO_ROOT_PASSWORD=
OBJECT_STORAGE_BUCKET=aivle-ai-artifacts
AI_ARTIFACT_HTTP_TIMEOUT_SECONDS=10
AI_ARTIFACT_MAX_BYTES=1048576

# Local background processing
DOCUMENT_JOB_RUNNER_ENABLED=true
DOCUMENT_JOB_POLL_INTERVAL=5s
DOCUMENT_JOB_RECOVERY_INTERVAL=30s
DOCUMENT_JOB_EXECUTION_TIMEOUT=2m
DOCUMENT_JOB_STALE_TIMEOUT=5m
